# Device
ro.product.odm.device=OP5CF9L1
ro.product.odm.model=PJE110
ro.product.odm.name=OP5CF9L1
ro.vendor.oplus.regionmark=CN

# Display / Pixelworks Iris 7P (Ace 3 DT pxlw,iris-chip-capability packed).
# Must match /sys/kernel/iris/chip_version (0x83770780). Wrong value (e.g. 0x407f0780)
# makes IrisFeature::hasIris7p() false and the wrapper loads the wrong passthrough
# (or none after i7p-only packaging). See ~/workdir/memc.md §8.
persist.vendor.display.pxlw.iris_feature=0x83770780
